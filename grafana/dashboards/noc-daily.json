      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "fg2h4oo9wupdsa"
          },
          "query": "routers = from(bucket: \"network\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"hardware_chassis\")\n  |> filter(fn: (r) => not exists r.test or r.test != \"true\")\n  |> keep(columns: [\"_time\", \"router\"])\n  |> group(columns: [\"router\"])\n  |> max(column: \"_time\")\n  |> filter(fn: (r) => r._time < time(v: int(v: now()) - 600000000000))\n  |> group()\n  |> count(column: \"router\")\n  |> rename(columns: {router: \"_value\"})\n  |> map(fn: (r) => ({_value: float(v: r._value)}))\n\nlinks = from(bucket: \"network\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"interface\" and (r._field == \"${f_oper}\" or r._field == \"${f_admin}\"))\n  |> last()\n  |> group()\n  |> reduce(\n      identity: {up: 0, total: 0},\n      fn: (r, accumulator) => ({\n        up: if r._field == \"${f_oper}\" and float(v: r._value) == 1.0 then accumulator.up + 1 else accumulator.up,\n        total: if r._field == \"${f_admin}\" and float(v: r._value) == 1.0 then accumulator.total + 1 else accumulator.total\n      })\n  )\n  |> map(fn: (r) => ({_value: float(v: r.total - r.up)}))\n\nhardware = from(bucket: \"network\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"hardware_chassis\" and r._field != \"${f_fan_count}\")\n  |> filter(fn: (r) => not exists r.test or r.test != \"true\")\n  |> last()\n  |> group()\n  |> min()\n  |> map(fn: (r) => ({_value: if float(v: r._value) < 1.0 then 1.0 else 0.0}))\n\nbackups = from(bucket: \"network\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"backup_status\" and r._field =~ /^(${f_backup_ok})$/)\n  |> filter(fn: (r) => not exists r.test or r.test != \"true\")\n  |> toFloat()\n  |> last()\n  |> map(fn: (r) => ({_value: if r._value < 1.0 or float(v: int(v: now()) - int(v: r._time)) / 1000000000.0 > 93600.0 then 1.0 else 0.0}))\n  |> group()\n  |> sum()\n\nscripts = from(bucket: \"network\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"script_run\" and r._field == \"duration_s\")\n  |> filter(fn: (r) => not exists r.test or r.test != \"true\")\n  |> group(columns: [\"script\"])\n  |> last()\n  |> map(fn: (r) => ({_value: if r.status == \"fail\" or float(v: int(v: now()) - int(v: r._time)) / 1000000000.0 > (if r.script == \"topology.py\" or r.script == \"hardware.py\" then 900.0 else 93600.0) then 1.0 else 0.0}))\n  |> group()\n  |> sum()\n\nunion(tables: [routers, links, hardware, backups, scripts])\n  |> group()\n  |> sum()",
          "refId": "A"
        }
      ],
      "title": "Système",
      "type": "stat"
    },
