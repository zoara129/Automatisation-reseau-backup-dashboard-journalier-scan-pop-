          "query": "sfp = from(bucket: \"network\")\n  |> range(start: -30m)\n  |> filter(fn: (r) => r._measurement == \"hardware_sfp\" and r._field =~ /temp|volt|bias|current|rx|tx/)\n  |> filter(fn: (r) => not exists r.test)\n  |> toFloat()\n  |> last()\n  |> map(fn: (r) => ({r with _field: if r._field =~ /temp/ then \"Temp SFP (°C)\" else if r._field =~ /volt/ then \"Tension (V)\" else if r._field =~ /bias|current/ then \"Courant (mA)\" else if r._field =~ /rx/ then \"Rx (dBm)\" else \"Tx (dBm)\"}))\n  |> keep(columns: [\"router\", \"port\", \"_field\", \"_value\"])\n  |> group()\n  |> pivot(rowKey: [\"router\", \"port\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n\nbase = from(bucket: \"network\")\n  |> range(start: -30m)\n  |> filter(fn: (r) => r._measurement == \"hardware_chassis\")\n  |> filter(fn: (r) => not exists r.test)\n  |> toFloat()\n  |> last()\n\nfans = base\n  |> filter(fn: (r) => r._field == \"fan_count\")\n  |> keep(columns: [\"router\", \"_value\"])\n  |> rename(columns: {_value: \"Ventilateurs\"})\n  |> group()\n\nstatus = base\n  |> filter(fn: (r) => r._field != \"fan_count\")\n  |> group(columns: [\"router\"])\n  |> min()\n  |> keep(columns: [\"router\", \"_value\"])\n  |> rename(columns: {_value: \"Statut\"})\n  |> group()\n\nchassis = join(tables: {f: fans, s: status}, on: [\"router\"])\n\njoin(tables: {a: sfp, b: chassis}, on: [\"router\"])\n  |> yield(name: \"hardware\")",
