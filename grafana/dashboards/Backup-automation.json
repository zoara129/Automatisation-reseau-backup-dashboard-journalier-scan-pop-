      },
      "description": "Stable si aucun routeur n'a une sauvegarde en échec ou de plus de 26 h, et si aucun script suivi (script_run) n'est en échec ou en retard. Ce panneau ne dépend pas du filtre Routeur pour les scripts.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "transparent",
                  "index": 0,
                  "text": "STABLE"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "from": 0.5,
                "result": {
                  "color": "red",
                  "index": 1,
                  "text": "À VÉRIFIER"
                },
                "to": 1000000
              },
              "type": "range"
            }
          ],
          "noValue": "Aucune donnée",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "fg2h4oo9wupdsa"
          },
          "query": "scripts = from(bucket: \"network\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"script_run\" and r._field == \"duration_s\")\n  |> filter(fn: (r) => not exists r.test)\n  |> group(columns: [\"script\"])\n  |> last()\n  |> map(fn: (r) => ({_value: if r.status == \"fail\" or float(v: int(v: now()) - int(v: r._time)) / 1000000000.0 > (if r.script == \"topology.py\" or r.script == \"hardware.py\" then 900.0 else 93600.0) then 1.0 else 0.0}))\n  |> group()\n  |> sum()\n\nbackups = from(bucket: \"network\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"backup_status\" and r._field =~ /success|status|^ok$/)\n  |> filter(fn: (r) => not exists r.test)\n  |> filter(fn: (r) => contains(value: r.router, set: ${router:json}))\n  |> toFloat()\n  |> last()\n  |> map(fn: (r) => ({_value: if r._value < 1.0 or float(v: int(v: now()) - int(v: r._time)) / 1000000000.0 > 93600.0 then 1.0 else 0.0}))\n  |> group()\n  |> sum()\n\nunion(tables: [scripts, backups])\n  |> group()\n  |> sum()",
          "refId": "A"
        }
      ],
      "title": "Système",
      "type": "stat"
    },
